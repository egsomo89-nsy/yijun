{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/autofill.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)\\.jsx",
      "headers": [{ "key": "Content-Type", "value": "text/jsx; charset=utf-8" }]
    }
  ]
}
